#!/usr/bin/env bash
set -euo pipefail

# Keep the Redact profile separate from the default Bitwarden CLI profile.
export BITWARDENCLI_APPDATA_DIR="$HOME/.config/Bitwarden CLI Redact"

session_file="${XDG_RUNTIME_DIR:-$HOME/.cache}/bw-redact/session"

persist_session() {
  local session="$1"
  local session_dir
  local temp_file

  session_dir="${session_file%/*}"
  umask 077
  mkdir -p "$session_dir"
  chmod 700 "$session_dir"
  temp_file="$(mktemp "${session_file}.XXXXXX")"
  printf '%s\n' "$session" >"$temp_file"
  chmod 600 "$temp_file"
  mv -f "$temp_file" "$session_file"
}

clear_session() {
  rm -f -- "$session_file"
}

if [[ "${1:-}" == unlock ]]; then
  if ! bw login --check >/dev/null 2>&1; then
    printf '%s\n' 'You are not logged in to the Redact Bitwarden profile. Run: bw-redact login' >&2
    exit 1
  fi

  shift
  raw=0
  for argument in "$@"; do
    if [[ "$argument" == --raw ]]; then
      raw=1
      break
    fi
  done

  session="$(bw unlock --raw "$@")"
  persist_session "$session"

  if ((raw)); then
    printf '%s\n' "$session"
  else
    printf '%s\n' 'Your vault is now unlocked.'
  fi
  exit 0
fi

if [[ -r "$session_file" ]]; then
  BW_SESSION="$(cat "$session_file")"
  export BW_SESSION
else
  unset BW_SESSION
fi

if [[ "${1:-}" == lock || "${1:-}" == logout ]]; then
  if bw "$@"; then
    clear_session
    exit 0
  else
    exit $?
  fi
fi

exec bw "$@"
