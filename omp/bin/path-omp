#!/usr/bin/env bun
import { spawn } from "bun";
import * as fs from "node:fs";
import { rewriteOmpResumeArgv } from "/home/marvin/.omp/bin/resolve-omp-resume.ts";

const DIST = `${process.env.HOME}/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/dist`;
const UPSTREAM = `${DIST}/cli.upstream.js`;
const FALLBACK = `${DIST}/cli.js`;
const CLI = fs.existsSync(UPSTREAM) ? UPSTREAM : FALLBACK;

if (process.argv[2] === "--omp-resolve") {
	for (const arg of rewriteOmpResumeArgv(process.argv.slice(3))) {
		process.stdout.write(`${arg}\n`);
	}
	process.exit(0);
}

const args = rewriteOmpResumeArgv(process.argv.slice(2));
const proc = spawn(["bun", CLI, ...args], {
	stdin: "inherit",
	stdout: "inherit",
	stderr: "inherit",
});
process.exitCode = await proc.exited;
