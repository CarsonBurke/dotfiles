#!/usr/bin/env bun
import { spawn } from "bun";
import * as fs from "node:fs";
import * as path from "node:path";
import { rewriteOmpResumeArgv } from "./resolve-omp-resume.ts";

const DIST = path.resolve(
	import.meta.dir,
	"../../.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/dist",
);
const UPSTREAM = path.join(DIST, "cli.upstream.js");
const FALLBACK = path.join(DIST, "cli.js");
const CLI = fs.existsSync(UPSTREAM) ? UPSTREAM : FALLBACK;

if (process.argv[2] === "--omp-resolve") {
	for (const arg of rewriteOmpResumeArgv(process.argv.slice(3))) {
		process.stdout.write(`${arg}\n`);
	}
	process.exit(0);
}

const args = rewriteOmpResumeArgv(process.argv.slice(2));
const proc = spawn(["bun", CLI, ...args], {
	stdin: "inherit",
	stdout: "inherit",
	stderr: "inherit",
});
process.exitCode = await proc.exited;
